# Maintainer: TrudeEH <aur at trude dot dev>

pkgname=universal-stickers-git
pkgver=0.1.0.r14.g776d014
pkgrel=1
pkgdesc="Small sticker and GIF picker built with GTK and Rust"
arch=('x86_64')
url="https://github.com/TrudeEH/universal-stickers"
license=('MIT')
depends=(
  'gcc-libs'
  'glibc'
  'gtk4'
  'libadwaita'
)
makedepends=(
  'cargo'
  'git'
)
optdepends=(
  'xdg-desktop-portal-gnome: GNOME global shortcut portal for Ctrl+Meta+Space'
)
provides=('universal-stickers')
conflicts=('universal-stickers')
source=("$pkgname::git+$url.git")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"

  local version revision commit
  version="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)"
  revision="$(git rev-list --count HEAD)"
  commit="$(git rev-parse --short HEAD)"

  printf '%s.r%s.g%s' "$version" "$revision" "$commit"
}

prepare() {
  cd "$pkgname"

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"

  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/cargo-target"

  cargo build --release --locked -p universal-stickers
}

package() {
  cd "$pkgname"

  DESTDIR="$pkgdir" PREFIX=/usr ./scripts/install-linux.sh
}
